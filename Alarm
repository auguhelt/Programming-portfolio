void draw() {
  if (forside) {
    visForside();
  } else if (hovedmenu) {
    visHovedmenu();
  } else if (alarm) {
    visAlarm();
  } else if (streak) {
    visStreak();
  } else if (indstillinger) {
    visIndstillinger();
  }
}

void customize(DropdownList ddl) {
  ddl.setItemHeight(25);
  ddl.setBarHeight(20);
  for (int i = 0; i < temaer.length; i++) {
    ddl.addItem(temaer[i], i);
  }
  ddl.setColorBackground(color(temaFarveKnapper[temaNummer]));
  ddl.setColorActive(color(temaFarveKnapper[temaNummer], 150));
  ddl.setColorForeground(color(temaFarveKnapper[temaNummer], 200));
  ddl.setColorLabel(color(temaFarveTekst[temaNummer]));
}

void controlEvent(ControlEvent theEvent) {
  String name = theEvent.getController().getName();
  
  if (name.equals("myList-d1")) {
    temaNummer = (int) theEvent.getValue();
    baggrund = temaFarveBaggrund[temaNummer];
  }

  if (name.equals("start")) {
    forside = false;
    streak = false;
    hovedmenu = true;
    indstillinger = false;
  } else if (name.equals("alarm")) {
    hovedmenu = false;
    streak = false;
    alarm = true;
    indstillinger = false;
  } else if (name.equals("streak")) {
    alarm = false;
    streak = true;
    hovedmenu = false;
    indstillinger = false;
  } else if (name.equals("tilbage")) {
    alarm = false;
    streak = false;
    hovedmenu = true;
    indstillinger = false;
  } else if (name.equals("indstillinger")) {
    alarm = false;
    streak = false;
    hovedmenu = false;
    indstillinger = true;
  } 
  updateVisibility();
  username = cp5start.get(Textfield.class, "username").getText();
}


void updateVisibility() {
  cp5start.setVisible(forside);
  cp5hovedmenu.setVisible(hovedmenu);
  cp5alarm.setVisible(alarm);
  cp5streak.setVisible(streak);
  cp5indstillinger.setVisible(indstillinger);
}

