// Ser om siderne = true så den kan gå ned i vores void visX og sætter alt op som siden skal se ud.
void draw() {
  if (forside) {
    visForside();
  } else if (hovedmenu) {
    visHovedmenu();
  } else if (alarm) {
    visAlarm();
  } else if (streak) {
    visStreak();
  } else if (indstillinger) {
    visIndstillinger();
  }
  checkAlarm(); // Tjek tiden hver frame
}



void controlEvent(ControlEvent theEvent) {
  String name = theEvent.getController().getName();

  if (name.equals("tema")) {
    temaNummer = (int) theEvent.getValue();
    baggrund = temaFarveBaggrund[temaNummer];
  }



  // Sætter visibiliteten af programmerne så kun de knapper som vi vil have bliver vist --------------------------------------------------------------------------------
  if (name.equals("start")) {
    forside = false;
    streak = false;
    hovedmenu = true;
    indstillinger = false;
  } else if (name.equals("alarm")) {
    hovedmenu = false;
    streak = false;
    alarm = true;
    indstillinger = false;
  } else if (name.equals("streak")) {
    alarm = false;
    streak = true;
    hovedmenu = false;
    indstillinger = false;
  } else if (name.equals("tilbage")) {
    alarm = false;
    streak = false;
    hovedmenu = true;
    indstillinger = false;
  } else if (name.equals("indstillinger")) {
    alarm = false;
    streak = false;
    hovedmenu = false;
    indstillinger = true;
  }
  updateVisibility();
  username = cp5start.get(Textfield.class, "username").getText();
}


// Sætter så controlp5 knappernes visibilitet hænger sammen med nogle ord så vi kan ændre det senere -----------------------------------------
