void startStopAlarm() {
  if (alarmActive == false) {
    totalSekunder = konverterTid(tidInput.getText());
    if (totalSekunder > 0) {
      setAlarm(totalSekunder);
      alarmActive = true;
      startKnap.setLabel("Stop");
    }
  } else {
    alarmActive = false;
    alarmigang = false;
    alarmstart = false;
    startKnap.setLabel("Start");
    alarmColor = color(240);
  }
}

//Her laver vi alt til alarmen ----------------------------------------------------------------------------------------------------
void setAlarm(int sekunder) {
  alarmtilbage = sekunder * 1000;
  alarmstartid = millis();
  alarmigang = true;
  alarmstart = false;
}

void checkAlarm() {
  if (alarmigang && (millis() - alarmstartid) >= alarmtilbage) {
    alarmigang = false;
    alarmstart = true;
    println("ALARM!");
  }
}

String getRemainingTime() {
  if (alarmigang == false) return "00:00:00";

  tilbage = max(0, alarmtilbage - (millis() - alarmstartid));
  timer = tilbage / 3600000;
  tilbage %= 3600000;
  minutter = tilbage / 60000;
  tilbage %= 60000;
  sekunder = tilbage / 1000;

  return nf(timer, 2) + ":" + nf(minutter, 2) + ":" + nf(sekunder, 2); // Her laver vi formatet om så det ser rigtigt ud.
}

int konverterTid(String tid) {
  String[] del = tid.split(":"); // Her splitter vi tid-strengen i timer, minutter, sekunder
  if (del.length != 3) return 0; // Her tjekker vi om der er 3 dele  vi

  // Her laver vi hver del til tal så det kan blive regnet med
  int timer1 = int(del[0]);
  int minutter1 = int(del[1]);
  int sekunder1 = int(del[2]);

  // Returner totalt antal sekunder
  return timer1 * 3600 + minutter1 * 60 + sekunder1;
}


// Her laver vi alt med streak at gøre ---------------------------------------------------------
void kalender() {

  // Tegn kalender
  textSize(16);
  for (int i = 0; i < 7; i++) {
    // Dag-navn
    fill(temaFarveTekst[temaNummer]);
    text(ugedage[i], startX + i*(boksStørelse+Mellemrum) + boksStørelse/2, 250);


    if (i == 0) {
      fill(registresøvn ? color(200) : color(0, 200, 0));
    } else {
      fill(150);
    }
    rect(startX + i*(boksStørelse+Mellemrum), 270, boksStørelse, boksStørelse, 5);
  }
}

// Her laver vi en timer til vores tingest som jeg ikke kan huske.
void tjekTimerTid() {
  if (registresøvn == false && millis() - timerStartTid >= timerTid) {
    registresøvn = true;
  }
}

String TidTilbage() {
  int remaining = timerTid - (millis() - timerStartTid);
  int timer = remaining / 3600000;
  int minutter = (remaining % 3600000) / 60000;
  return nf(timer, 2) + "t " + nf(minutter, 2) + "m";
}

void godSøvn() {
  if (registresøvn) {
    streakTal++;
    startTimer();
  }
}

void dårligSøvn() {
  if (registresøvn) {
    streakTal = 0;
    startTimer();
  }
}

void startTimer() {
  registresøvn = false;
  timerStartTid = millis();
}
