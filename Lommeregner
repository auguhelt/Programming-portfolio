// Udregning August 
void calculateResult() { try {
    String[] parts = display.split(" ");
    float result = 0;
    result = stringToFloat(parts[0]);
    for (int i = 1; i < parts.length; i += 2) {
      String op = parts[i];
      if (op.equals("sin")) {result = sin(result); }
      else if (op.equals("cos")) {result = cos(result); } 
      else if (op.equals("tan")) {result = tan(result); }
      else if (op.equals("√")) {result = sqrt(result); } 
      else if (op.equals("^")) {result = pow(result, stringToFloat(parts[i + 1]));} 
      else {
        float nextNum = stringToFloat(parts[i + 1]);
        if (op.equals("+")) {result += nextNum; }
          else if (op.equals("-")) {result -= nextNum; }
          else if (op.equals("*")) {result *= nextNum; } 
          else if (op.equals("/")) {result /= nextNum; }
        }
      }
      display = "" + result; 
    } 
    catch (Exception e) {display = "Fejl";
  }
}

float stringToFloat(String input) {
  int result = 0;
  boolean NegTal = false;
  if (input.charAt(0) == '-') {NegTal = true;}
    for (int i = NegTal ? 1 : 0; i < input.length(); i++) {result = result * 10 + (input.charAt(i) - '0');}
    if (NegTal) {result = -result;}
    return result;
}





